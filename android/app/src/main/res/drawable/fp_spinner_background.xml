<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_border" />
            <corners android:radius="14dp" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="40dp"
                android:bottom="0dp" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="end|center_vertical"
        android:right="12dp"
        android:drawable="@drawable/fp_chevron_down" />
</layer-list>
